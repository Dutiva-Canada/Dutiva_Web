# Self-host image for the Dutiva web bundle — docs/SELF_HOSTING.md is the
# runbook that goes with this file.
#
# Multi-stage: node builds `dist/`, nginx serves it. The steps mirror
# `npm run build` minus the validators (tsc, validate-seo, check-entry-graph)
# — those are CI-side gates, not emitters. Prerender is REQUIRED: it writes
# dist/app.html, the shell every /app route serves — without it the
# workspace 404s even though the marketing pages load.
#
# VITE_* values are compile-time inputs (Vite inlines them), so they are
# build args — changing them means rebuilding the image, not restarting it.

FROM node:22-bookworm-slim AS build
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_ANON_KEY
ARG VITE_SITE_ORIGIN
ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL \
    VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY \
    VITE_SITE_ORIGIN=$VITE_SITE_ORIGIN

RUN npx vite build \
 && npx vite build --ssr src/entry-server.tsx --outDir dist-ssr \
 && node scripts/prerender.mjs \
 && node scripts/generate-sw.mjs

FROM nginx:1.27-alpine
# nginx.conf.template is envsubst-processed into /etc/nginx/conf.d/ at
# container start; NGINX_ENVSUBST_FILTER keeps nginx's own $vars intact.
ENV NGINX_ENVSUBST_FILTER=SELFHOST_
COPY deploy/self-host/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
